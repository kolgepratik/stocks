# ── LLM ──────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-haiku-5-5"
LLM_PROVIDER="anthropic"
ENABLE_LLM_FALLBACK=false

GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash"

# ── Database ──────────────────────────────────────────────────────────────────
# Local SQLite default; on Railway set automatically by Postgres plugin (postgresql://...)
DATABASE_URL="sqlite:///./data/trading.db"

# ── API Security & Cloud (Railway) ────────────────────────────────────────────
# Set a strong secret in Railway so all /api/* endpoints require X-API-Key or Bearer token
API_KEY=""
CORS_ORIGINS="*"
TELEGRAM_WEBHOOK_SECRET=""
CRON_SECRET=""

# ── Notifications (WhatsApp or Telegram) ──────────────────────────────────────
NOTIFICATION_CHANNEL="WHATSAPP"
WHATSAPP_PHONE=""
WHATSAPP_API_KEY=""

# ── Telegram ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# ── Alpaca ────────────────────────────────────────────────────────────────────
ALPACA_API_KEY=""
ALPACA_SECRET_KEY=""
ALPACA_PAPER=true

# ── Robinhood ─────────────────────────────────────────────────────────────────
ROBINHOOD_USERNAME=""
ROBINHOOD_PASSWORD=""
ROBINHOOD_MFA_TOTP=""

# ── Budget & Risk Controls ─────────────────────────────────────────────────
WEEKLY_BUDGET_USD=500.0
MAX_COST_PER_TRADE_USD=500.0
TARGET_GAIN_PERCENT=50.0
STOP_LOSS_PERCENT=25.0
STRATEGY_MODE="steady"
IV_RANK_SPREAD_THRESHOLD=50.0

# ── Scanner ───────────────────────────────────────────────────────────────────
# Comma-separated list of tickers to screen
SCAN_UNIVERSE="AAPL,MSFT,NVDA,TSLA,AMD,META,GOOGL,AMZN,SPY,QQQ,COIN,PLTR,SOFI,RIVN,MARA"
TARGET_DTE=7
MAX_CANDIDATES=5
